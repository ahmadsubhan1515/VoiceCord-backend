# Server Configuration
PORT=8080
NODE_ENV=development

# Dashboard Authentication (REQUIRED — set these on Vercel too)
ADMIN_USER=xxxxx
ADMIN_PASS=xxxxxx

# Supabase Configuration (REQUIRED for saving tokens)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=xxxxxxxxx
SUPABASE_KEY=xxxxxxxxx

# Optional: Custom storage directory for config.json (local only)
# DATA_DIR=./data
